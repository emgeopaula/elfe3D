python module pyelfe3d
  interface

    ! elfe3d:mod_elfe3d.f90
    module elfe3d

      ! Expose the allocatable module variables to Python
      double precision dimension(:), allocatable :: Jvec
      double precision dimension(:), allocatable :: JTvec
      integer(kind=8) dimension(:), allocatable :: Jrows
      integer(kind=8) dimension(:), allocatable :: Jcols
      double precision dimension(:), allocatable :: test_data_vec
      double precision dimension(:), allocatable :: forward_data
      double precision dimension(:), allocatable :: inv_model
      double precision dimension(:), allocatable :: observed_data
      double precision dimension(:), allocatable :: errors

      ! Expose main solver
      subroutine solve
      end subroutine solve

    end module elfe3d

    ! Expose utility functions
    subroutine get_jrows_size(n_jrows)
      integer(kind=8) intent(out) :: n_jrows
    end subroutine get_jrows_size

    subroutine get_jcols_size(n_jcols)
      integer(kind=8) intent(out) :: n_jcols
    end subroutine get_jcols_size

  end interface
end python module pyelfe3d